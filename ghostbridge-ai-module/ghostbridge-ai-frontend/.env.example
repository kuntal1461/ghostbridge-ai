# Non-secret frontend configuration only. NEVER put API keys or tokens here, and never use a VITE_ name for a secret:
# every VITE_* value is embedded in the public JavaScript bundle.

# Base URL of the GhostBridge backend. Leave empty to use the page's own origin (recommended: reverse proxy / Vite proxy).
VITE_API_BASE_URL=

# Request timeout in milliseconds (1000..300000, default 60000).
VITE_API_TIMEOUT_MS=60000

# Comma separated, operator-approved structured-output schema identifiers (default: generic-summary).
VITE_AI_STRUCTURED_SCHEMAS=generic-summary

# Development only: serve synthetic data instead of calling the backend. Ignored in production builds.
VITE_AI_MOCK=false

# Dev server only (not embedded in the bundle): where Vite forwards /api.
DEV_PROXY_TARGET=http://localhost:8080
