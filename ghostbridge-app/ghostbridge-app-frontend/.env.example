# Non-secret configuration only; every VITE_* value is public (embedded in the bundle). Never put a key or token here.

# Base URL of GhostBridge App. Leave empty to use the page's own origin (recommended: reverse proxy / Vite proxy).
VITE_API_BASE_URL=

# Request timeout in milliseconds (1000..300000, default 60000; local models can be slow: 120000 is reasonable).
VITE_API_TIMEOUT_MS=120000

# Comma separated approved structured-output schema identifiers (default: generic-summary).
VITE_AI_STRUCTURED_SCHEMAS=generic-summary

# Development only, ignored in production builds. Leave false to use the real backend.
VITE_AI_MOCK=false

# Dev server only (not embedded in the bundle): where Vite forwards /api.
DEV_PROXY_TARGET=http://localhost:8080
