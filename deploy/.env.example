# Copy to deploy/.env (git-ignored) and fill in on the server. NEVER commit the filled file.
SITE_ADDRESS=ghostbridge.example.org
# A model already pulled into the ollama volume (see README: "Provision the model").
OLLAMA_MODEL=
OLLAMA_MEM_LIMIT=6g
DEMO_USERNAME=demo
# A bcrypt hash only, never the password: htpasswd -nbBC 10 x 'the-password' | cut -d: -f2   then prefix with {bcrypt}
DEMO_PASSWORD_HASH=
