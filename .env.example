# GhostBridge AI - example environment (placeholders only).
# Copy to a local, git-ignored file (for example `.env`) or set these in your runtime/secrets manager.
# NEVER put a real value in this file and never commit a filled-in copy.

# Ollama Cloud API key. Backend-only: never expose it to the frontend, never prefix it with VITE_,
# never log it. Provide it through the runtime environment or a secrets manager.
OLLAMA_API_KEY=

# Provider selection and model (no defaults are shipped; choose the model you are entitled to use).
GHOSTBRIDGE_AI_PROVIDER=
GHOSTBRIDGE_AI_MODEL_ID=

# --- Ollama deployment selection (GB-AI-005). Applies when GHOSTBRIDGE_AI_PROVIDER=ollama. Read at startup: restart to change.
# The mode must be explicit. A missing, blank or misspelled setting never selects the paid cloud: startup fails instead.
#   true  = self-hosted Ollama (recommended for development; no key is read or sent)
#   false = Ollama Cloud (paid; needs OLLAMA_API_KEY)
# Only when exactly one side is configured is the mode inferred (only LOCAL_* set: local; only CLOUD_* set: cloud).
GHOSTBRIDGE_AI_OLLAMA_LOCAL_ENABLED=
# Local mode: loopback/private endpoint (http allowed only for localhost, 127.0.0.0/8, ::1, 10/8, 172.16/12, 192.168/16,
# fc00::/7 or hosts listed in GHOSTBRIDGE_AI_OLLAMA_LOCAL_ALLOWED_HOSTS; link-local ranges need allow-listing).
# Keep Ollama's port 11434 on loopback or a private network; never publish it.
GHOSTBRIDGE_AI_OLLAMA_LOCAL_BASE_URL=
GHOSTBRIDGE_AI_OLLAMA_LOCAL_MODEL=
GHOSTBRIDGE_AI_OLLAMA_LOCAL_ALLOWED_HOSTS=
# Cloud mode model (the cloud endpoint defaults to https://ollama.com).
GHOSTBRIDGE_AI_OLLAMA_CLOUD_MODEL=
