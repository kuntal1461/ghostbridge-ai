# GhostBridge AI - example environment (placeholders only).
# Copy to a local, git-ignored file (for example `.env`) or set these in your runtime/secrets manager.
# NEVER put a real value in this file and never commit a filled-in copy.

# Ollama Cloud API key. Backend-only: never expose it to the frontend, never prefix it with VITE_,
# never log it. Provide it through the runtime environment or a secrets manager.
OLLAMA_API_KEY=

# Provider selection and model (no defaults are shipped; choose the model you are entitled to use).
GHOSTBRIDGE_AI_PROVIDER=
GHOSTBRIDGE_AI_MODEL_ID=
